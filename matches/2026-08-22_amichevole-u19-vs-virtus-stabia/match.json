  "reflection": {
    "wentWell": [
      {
        "id": "wwb-01",
        "text": {
          "en": "Passing more vertical and progressive — better line-breaking, higher success rate, and progressions that led to goals.",
          "it": "Passaggi più verticali e progressivi: più rotture di linea, più riuscita, e sviluppi che portano al gol."
        }
      },
      {
        "id": "wwb-02",
        "text": {
          "en": "Combination quality improved: 1H right side (Baridó–Melnyk); 2H left side (Kenmogne with Liccardo after the Chiaiese switch).",
          "it": "Qualità delle combinazioni: 1°T lato destro (Baridó–Melnyk); 2°T lato sinistro (Kenmogne con Liccardo dopo lo scambio con Chiaiese)."
        }
      },
      {
        "id": "wwb-03",
        "text": {
          "en": "High defence strong despite limited training — aggressive, PPDA 8.0 (ultra-high press); 1H 7.6 / 2H 8.3; most recoveries in their half; fed counters.",
          "it": "Blocco alto solido (poco allenato): aggressivi, PPDA 8,0 (pressing ultra-alto); 1°T 7,6 / 2°T 8,3; tanti recuperi nella loro metà; ripartenze."
        }
      },
      {
        "id": "wwb-04",
        "text": {
          "en": "Clear growth in chance creation — high volume of opportunities.",
          "it": "Miglioramento netto nella creazione di occasioni — alto volume di chance."
        }
      },
      {
        "id": "wwb-05",
        "text": {
          "en": "Good reading of when to dictate play vs when to counter; quicker reactions to win the ball back.",
          "it": "Buona lettura tra gestire e ripartire; reazioni più rapide nel riconquistare palla."
        }
      },
      {
        "id": "wwb-06",
        "text": {
          "en": "Best friendly of the pre-season so far.",
          "it": "Migliore amichevole del periodo finora."
        }
      }
    ],
    "evenBetterIf": [
      {
        "id": "ebi-01",
        "text": {
          "en": "Counter-press longevity: hold the press ~6–7s (now often ~4–5s); once they reorganise we stop — next week’s short-sprint quickness work should help.",
          "it": "Longevità del contropressing: tenere ~6–7s (ora spesso ~4–5s); appena riorganizzano si ferma — il lavoro di rapidità (sprint brevi) della prossima settimana aiuterà."
        }
      },
      {
        "id": "ebi-02",
        "text": {
          "en": "Convert chances: 14 shots, 8 on target, xG ~1.90 — four 1v1s including a 1v0 / open goal miss; finishing must be better.",
          "it": "Concretizzare: 14 tiri, 8 in porta, xG ~1,90 — quattro 1v1 di cui un 1v0 / porta vuota fallita; il tiro in porta deve migliorare."
        }
      },
      {
        "id": "ebi-03",
        "text": {
          "en": "Creative no. 10s more instinctive — take more shots from range.",
          "it": "N.10 creativi più istintivi — più tiri da fuori area."
        }
      },
      {
        "id": "ebi-04",
        "text": {
          "en": "No. 10 positioning: stay wide; only come central when the ball is on your side. Don’t drift central when play is opposite — keep the midfield box.",
          "it": "Posizionamento n.10: restare larghi; entrare solo quando la palla è dal proprio lato. Non centralizzarsi a gioco opposto — mantenere il rombo/box di centrocampo."
        }
      },
      {
        "id": "ebi-05",
        "text": {
          "en": "2H tempo: midfielders more progressive and risk-taking — forward / diagonal / long to the striker in 1v1; don’t always wait for the perfect pass.",
          "it": "2°T: centrocampisti più progressivi e propensi al rischio — avanti / diagonale / lungo sulla punta in 1v1; non cercare sempre il passaggio perfetto."
        }
      },
      {
        "id": "ebi-06",
        "text": {
          "en": "Zappalà–Branchizio: both delay and hold. Zappalà is often over-eager to press; if he goes, Branchizio must delay and hold cover (not man-to-man) or space opens and balls go over the top. In 1v1, Zappalà should delay rather than dive in — that’s when he gets beaten easily.",
          "it": "Zappalà–Branchizio: entrambi temporizzano e tengono. Zappalà è spesso troppo aggressivo in pressing; se esce, Branchizio deve temporizzare e restare in copertura (non a uomo), altrimenti si apre spazio e arriva palla dietro. Nell’1v1 Zappalà deve temporizzare, non buttarsi — lì viene superato facilmente."
        }
      }
    ]
  }
}
